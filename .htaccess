# Fallback only: used if the web server document root is ever pointed at the
# project root instead of public/. Everything is forwarded into public/ so
# .env, vendor/, storage/ and the rest of the project are never served.
<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never serve dotfiles (.env, .git, .htaccess) or Composer/npm manifests.
<FilesMatch "^(\.|composer\.(json|lock)$|package(-lock)?\.json$|artisan$)">
    Require all denied
</FilesMatch>
