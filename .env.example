APP_NAME="ICRE Tabulation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# --- Conference branding (shown on login, sidebar and printed sheets) ---
CONFERENCE_ACRONYM="ICSS-ESHET 2026"
CONFERENCE_EDITION="2nd International Conference"
CONFERENCE_NAME="2nd International Conference on Sustainable Solutions in Engineering, Science, Health, Education, and Technology"
CONFERENCE_SHORT_NAME="ICSS-ESHET Tabulation"
CONFERENCE_THEME="Research and Extension"
CONFERENCE_ORGANIZER="Isabela State University"
CONFERENCE_CAMPUS="City of Ilagan Campus"
CONFERENCE_DATES="September 23-25, 2026"
CONFERENCE_STARTS_AT="2026-09-23T08:00:00+08:00"
CONFERENCE_VENUE="City of Ilagan, Isabela"
CONFERENCE_FORMAT="Physical and Online"
CONFERENCE_WEBSITE="https://rdet-isu-ilagan.net/index"
CONFERENCE_EMAIL=research.ilagan@isu.edu.ph
CONFERENCE_PHONE="+63 949 597 4328"
CONFERENCE_YEAR=2026

# --- Initial administrator (used once by `php artisan db:seed`) ---
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database: MySQL recommended for production; sqlite works for local testing ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tabulation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${CONFERENCE_SHORT_NAME}"

# Laravel Pulse profiling (adds DB writes on every request). Keep off in production.
PULSE_ENABLED=false

# --- Developer credit shown on the welcome, login and error pages ---
DEVELOPER_NAME="Philippine Information Technology of the North"
DEVELOPER_SHORT_NAME=PITON
DEVELOPER_TAGLINE="Est. 2007"
DEVELOPER_URL=
DEVELOPER_LOGO=/img/piton-logo.png
